DOMAIN=backtest.example.com
DATA_DIR=/data
CACHE_DIR=/data/cache
DATABASE_URL=sqlite:////data/backtests.sqlite3
ALLOWED_ORIGINS=https://backtest.example.com
ALLOWED_HOSTS=backtest.example.com,backend
YAHOO_REQUEST_TIMEOUT_SECONDS=20
YAHOO_MAX_RETRIES=3
YAHOO_RETRY_BACKOFF_SECONDS=1
YAHOO_STATUS_TIMEOUT_SECONDS=3
YAHOO_OFFLINE_COOLDOWN_SECONDS=300
YAHOO_STATUS_CACHE_SECONDS=60
STOOQ_REQUEST_TIMEOUT_SECONDS=20
STOOQ_MAX_RETRIES=2
STOOQ_RETRY_BACKOFF_SECONDS=1
STOOQ_STATUS_TIMEOUT_SECONDS=3
STOOQ_STATUS_CACHE_SECONDS=60
