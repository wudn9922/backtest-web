# Copy to a local .env only when needed. Never put real credentials in Git.
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
ALLOWED_HOSTS=localhost,127.0.0.1
DATA_DIR=../data
CACHE_DIR=../data/cache
DATABASE_URL=sqlite:///../data/backtests.sqlite3
RESEARCH_DATA_DIR=../data
RESEARCH_REPORTS_DIR=../reports
MAX_REQUEST_BYTES=1048576
YAHOO_REQUEST_TIMEOUT_SECONDS=20
YAHOO_MAX_RETRIES=3
YAHOO_RETRY_BACKOFF_SECONDS=1
YAHOO_STATUS_TIMEOUT_SECONDS=3
YAHOO_OFFLINE_COOLDOWN_SECONDS=300
YAHOO_STATUS_CACHE_SECONDS=60
STOOQ_REQUEST_TIMEOUT_SECONDS=20
STOOQ_MAX_RETRIES=2
STOOQ_RETRY_BACKOFF_SECONDS=1
STOOQ_STATUS_TIMEOUT_SECONDS=3
STOOQ_STATUS_CACHE_SECONDS=60
STOOQ_OFFLINE_COOLDOWN_SECONDS=300
